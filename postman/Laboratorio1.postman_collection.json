{
  "info": {
    "name": "Laboratorio 1 - Productos y Categorías",
    "description": "Flujo: obtener CSRF, iniciar sesión y probar los CRUD. Los scripts guardan CSRF y JWT automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "Admin123!" },
    { "key": "token", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "categoriaId", "value": "1" },
    { "key": "productoId", "value": "1" }
  ],
  "item": [
    { "name": "0. Obtener CSRF", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/csrf" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('csrfToken', body.token);"] } }] },
    { "name": "1. Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"] } }] },
    { "name": "2. Crear categoría", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Accesorios\",\n  \"descripcion\": \"Accesorios varios\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/categorias" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('categoriaId', pm.response.json().id);"] } }] },
    { "name": "3. Listar categorías", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/categorias" } },
    { "name": "4. Actualizar categoría", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Accesorios actualizados\",\n  \"descripcion\": \"Descripción actualizada\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" } },
    { "name": "5. Crear producto", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cable USB\",\n  \"descripcion\": \"Cable de carga\",\n  \"precio\": 2500.00,\n  \"cantidadStock\": 20,\n  \"categoriaId\": {{categoriaId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/productos" }, "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('productoId', pm.response.json().id);"] } }] },
    { "name": "6. Listar productos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/productos" } },
    { "name": "7. Actualizar producto", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cable USB actualizado\",\n  \"descripcion\": \"Cable reforzado\",\n  \"precio\": 3000.00,\n  \"cantidadStock\": 25,\n  \"categoriaId\": {{categoriaId}}\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/productos/{{productoId}}" } },
    { "name": "8. Borrar producto", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/productos/{{productoId}}" } },
    { "name": "9. Borrar categoría", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/api/categorias/{{categoriaId}}" } }
  ]
}
